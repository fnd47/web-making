:root {
  --bg: #070b11;
  --bg-soft: #0e151d;
  --panel: rgba(18, 25, 33, 0.88);
  --panel-strong: #121a22;
  --text: #edf3f8;
  --muted: #a6b3c0;
  --line: rgba(255, 255, 255, 0.08);
  --accent: #d72638;
  --accent-soft: rgba(215, 38, 56, 0.18);
  --silver: #dce7ef;
  --shadow: 0 20px 45px rgba(0, 0, 0, 0.28);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: very smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: "Inter", sans-serif;
  background:
    radial-gradient(circle at top, rgba(215, 38, 56, 0.2), transparent 30%),
    linear-gradient(135deg, #05080d 0%, #0b1018 35%, #101923 100%);
  color: var(--text);
  overflow-x: hidden;
  overflow-y: auto;
}

body.loaded {
  overflow-x: hidden;
  overflow-y: auto;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

.landing-screen {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: grid;
  place-items: center;
  background: rgba(5, 8, 13, 0.72);
  backdrop-filter: blur(6px);
  transition: opacity 0.8s ease, visibility 0.8s ease;
}

.landing-screen__backdrop {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(120deg, rgba(7, 11, 17, 0.72), rgba(7, 11, 17, 0.35)),
    url("../img/Audi-front page.jpg") center center / cover no-repeat;
  filter: saturate(0.8) brightness(0.7);
  transform: scale(1.08);
}

.landing-screen__content {
  position: relative;
  z-index: 1;
  max-width: 740px;
  padding: 42px 28px;
  text-align: center;
}

.landing-title {
  display: block;
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(5rem, 13vw, 12rem);
  line-height: 0.8;
  letter-spacing: -0.08em;
  color: #f2f6fa;
}

.landing-screen__text {
  max-width: 540px;
  margin: 18px auto 0;
  color: rgba(237, 243, 248, 0.82);
  font-size: 1.05rem;
  line-height: 1.8;
}

.landing-button {
  margin-top: 28px;
  cursor: pointer;
}

.site-content {
  position: relative;
  z-index: 1;
  opacity: 0;
  transform: translateY(30px);
  pointer-events: none;
  transition: opacity 0.9s ease, transform 0.9s ease;
}

body.loaded .site-content {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

body.loaded .landing-screen {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.page-shell {
  width: min(1200px, calc(100% - 32px));
  margin: 18px auto 36px;
  padding: 18px 18px 0;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: rgba(7, 11, 17, 0.72);
  backdrop-filter: blur(12px);
  box-shadow: var(--shadow);
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22px;
  padding: 12px 18px 16px;
  border-bottom: 1px solid var(--line);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  letter-spacing: 0.24em;
  font-weight: 700;
}

.brand img {
  border-radius: 8px;
  margin-right: 5px;
  vertical-align: middle;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: 8px;
  background: linear-gradient(145deg, var(--accent), #7e1018);
  box-shadow: 0 12px 28px rgba(215, 38, 56, 0.38);
  overflow: hidden;
}

.brand-name {
  font-size: 0.8rem;
}

.main-nav {
  display: inline-flex;
  align-items: center;
  gap: 24px;
  padding: 8px 16px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.02);
  flex-wrap: wrap;
  justify-content: center;
}

.main-nav a {
  color: var(--muted);
  font-size: 0.82rem;
  transition: color 0.2s ease;
}

.main-nav a:hover,
.main-nav a:focus-visible {
  color: var(--text);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.85rem 1.4rem;
  border-radius: 999px;
  border: 1px solid transparent;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.button:hover,
.button:focus-visible {
  transform: translateY(-1px);
}

.button--ghost {
  border-color: var(--line);
  background: rgba(255, 255, 255, 0.02);
}

.button--primary {
  background: linear-gradient(135deg, var(--accent), #9c1422);
  box-shadow: 0 12px 26px rgba(215, 38, 56, 0.35);
}

.button--secondary {
  border-color: var(--line);
  background: rgba(255, 255, 255, 0.02);
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 30px;
  padding: 52px 22px 24px;
}

.eyebrow,
.section-tag {
  margin: 0 0 18px;
  color: var(--silver);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.26em;
  text-transform: uppercase;
}

.hero h1 {
  margin: 0;
  max-width: 12ch;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(4rem, 7vw, 7rem);
  font-weight: 600;
  line-height: 0.88;
  letter-spacing: -0.06em;
}

.lead {
  max-width: 560px;
  margin-top: 22px;
  color: var(--muted);
  font-size: 1.04rem;
  line-height: 1.8;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 28px;
}

.hero__visual {
  position: relative;
  width: 100%;
  min-height: 480px;
  aspect-ratio: 16 / 10;
  border-radius: 26px;
  overflow: hidden;
  border: none;
  background: transparent;
  box-shadow: none;
}

.hero__visual img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: 26px;
  filter: saturate(0.95) contrast(1.1);
}

.hero__badge {
  position: absolute;
  z-index: 1;
  top: 22px;
  left: 22px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 14px 18px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  background: rgba(10, 14, 18, 0.46);
  backdrop-filter: blur(10px);
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--silver);
}

.hero__badge span:last-child {
  font-size: 1.1rem;
  letter-spacing: 0.06em;
  color: var(--text);
}

.badge-label {
  color: var(--silver);
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.hero__badge strong {
  font-size: 1rem;
}

.story,
.showcase,
.experience,
.collection-section {
  padding: 28px 22px 8px;
}

.story__header {
  max-width: 760px;
  margin-bottom: 18px;
}

.story__header h2,
.showcase__content h2,
.experience__text h2,
.collection-header h2 {
  margin: 0;
  font-size: clamp(2.1rem, 4vw, 3.6rem);
  line-height: 1.08;
  letter-spacing: -0.05em;
}

.story__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 28px;
}

.feature-card {
  padding: 26px 22px 22px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(16, 23, 31, 0.8), rgba(10, 15, 18, 0.8));
}

.feature-card--wide {
  width: 100%;
}

.feature-index {
  display: inline-block;
  margin-bottom: 14px;
  color: var(--accent);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.feature-card h3 {
  margin: 0 0 12px;
  font-size: 1.4rem;
}

.feature-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.showcase {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  align-items: center;
  gap: 26px;
  padding-top: 42px;
}

.showcase__content p {
  color: var(--muted);
  line-height: 1.8;
  max-width: 560px;
}

.check-list {
  list-style: none;
  padding: 0;
  margin: 24px 0 0;
  display: grid;
  gap: 12px;
}

.check-list li {
  position: relative;
  padding-left: 26px;
  color: var(--text);
}

.check-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), #f17a78);
  box-shadow: 0 0 18px rgba(215, 38, 56, 0.82);
}

.showcase__panel {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: linear-gradient(180deg, rgba(17, 22, 30, 0.8), rgba(9, 13, 17, 0.95));
}

.panel-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 8px 16px;
  color: var(--white);
  font-size: 0.82rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.panel-visual {
  overflow: hidden;
  border-radius: 18px;
  border: 1px solid var(--line);
}

.panel-visual img {
  width: 100%;
  height: 360px;
  object-fit: cover;
}

.models-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
  padding: 28px 22px 8px;
}

.model-card {
  position: relative;
  min-height: 260px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background:
    linear-gradient(135deg, rgba(22, 32, 39, 0.72), rgba(11, 15, 19, 0.9)),
    url('img/audi%20A%20class.jpeg') center/cover no-repeat;
  overflow: hidden;
}

.model-card:nth-child(2) {
  background:
    linear-gradient(135deg, rgba(22, 32, 39, 0.72), rgba(11, 15, 19, 0.9)),
    url('img/audi%20Q%20class.jpeg') center/cover no-repeat;
}

.model-card:nth-child(3) {
  background:
    linear-gradient(135deg, rgba(22, 32, 39, 0.72), rgba(11, 15, 19, 0.9)),
    url('img/audi%20S%20class.jpeg') center/cover no-repeat;
}

.model-card:nth-child(4) {
  background:
    linear-gradient(135deg, rgba(22, 32, 39, 0.72), rgba(11, 15, 19, 0.9)),
    url('img/audi%20RS%20class.jpeg') center/cover no-repeat;
}

.model-card:nth-child(5) {
  background:
    linear-gradient(135deg, rgba(22, 32, 39, 0.72), rgba(11, 15, 19, 0.9)),
    url('img/audi%20e-Tron%20class.jpeg') center/cover no-repeat;
}

.model-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(9, 12, 16, 0.22), rgba(9, 12, 16, 0.92));
}

.model-card__link {
  position: relative;
  z-index: 1;
  display: block;
  height: 100%;
  padding: 20px 18px 18px;
  color: var(--text);
  text-decoration: none;
}

.model-card--featured {
  background:
    linear-gradient(135deg, rgba(174, 30, 42, 0.38), rgba(11, 15, 19, 0.84)),
    url('img/audi A class.jpeg') center/cover no-repeat;
}

.model-type {
  margin: 0;
  color: var(--silver);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.model-card h3 {
  margin: 20px 0 8px;
  font-size: clamp(2rem, 3vw, 2.7rem);
  letter-spacing: -0.06em;
}

.model-card p {
  margin: 0;
  max-width: 28ch;
  color: var(--muted);
  line-height: 1.7;
}

.model-card span {
  display: inline-block;
  margin-top: 22px;
  font-weight: 600;
  color: var(--text);
}

.feature-stack {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 28px;
}

.model-detail-page {
  background: linear-gradient(135deg, #04080d 0%, #0c1219 100%);
  color: var(--text);
}

.model-detail-shell {
  width: min(1100px, calc(100% - 32px));
  margin: 26px auto 42px;
  padding: 18px 18px 28px;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: rgba(7, 11, 17, 0.8);
  box-shadow: var(--shadow);
}

.model-detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 10px 8px 18px;
  border-bottom: 1px solid var(--line);
}

.model-detail-main {
  padding-top: 26px;
}

.model-detail-hero {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 24px;
  align-items: center;
  padding: 12px 8px 8px;
}

.model-detail-copy h1 {
  margin: 0;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(3.1rem, 6vw, 5.5rem);
  line-height: 0.9;
  letter-spacing: -0.05em;
}

.model-detail-copy p {
  margin-top: 20px;
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.8;
}

.model-detail-visual {
  overflow: hidden;
  border: none;
  border-radius: 24px;
  aspect-ratio: 16 / 10;
  min-height: 0;
}

.model-detail-visual img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.model-detail-content {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 32px;
}

.detail-copy {
  padding: 24px 22px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.02);
}

.detail-copy h2 {
  margin-top: 0;
  margin-bottom: 14px;
  font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.detail-copy p,
.feature-bullets {
  margin: 0;
  color: var(--muted);
  line-height: 1.8;
}

.detail-copy p {
  margin-bottom: 16px;
  font-size: 1rem;
}

.detail-copy p:last-child {
  margin-bottom: 0;
}

.feature-bullets {
  padding-left: 18px;
}

.metric-panel {
  margin-top: 30px;
  padding: 24px 22px;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: rgba(18, 25, 33, 0.72);
}

.metric-panel h3 {
  margin: 0 0 18px;
  font-size: 1.5rem;
}

.metric-row {
  display: grid;
  grid-template-columns: 110px 1fr;
  align-items: center;
  gap: 16px;
  margin-bottom: 14px;
}

.metric-row:last-child {
  margin-bottom: 0;
}

.metric-row span {
  color: var(--silver);
  font-weight: 600;
}

.metric-bar {
  height: 14px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
  border: 1px solid var(--line);
}

.metric-bar div {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent), #f07b69);
}

.experience {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 26px;
  align-items: center;
  padding-top: 38px;
}

.experience__text p,
.experience__quote p {
  color: var(--muted);
  line-height: 1.8;
}

.experience__quote {
  padding: 32px 28px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: linear-gradient(180deg, rgba(17, 22, 30, 0.9), rgba(10, 15, 18, 0.82));
}

.experience__quote p {
  margin: 0 0 12px;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.05;
  color: var(--text);
}

.experience__quote span {
  color: var(--silver);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-size: 0.7rem;
}

.footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 26px;
  padding: 28px 22px 26px;
  margin-top: 18px;
  border-top: 1px solid var(--line);
}

.footer p {
  margin: 10px 0 0;
  color: var(--muted);
}

.brand--footer {
  letter-spacing: 0.2em;
}

.footer__links,
.footer__meta {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
}

.footer__aside {
  width: min(220px, 100%);
  margin-left: auto;
  border: 1px solid var(--line);
  border-radius: 18px;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.02);
}

.footer__aside img {
  display: block;
  width: 100%;
  height: 160px;
  object-fit: cover;
}

.footer__links a,
.footer__meta a {
  transition: color 0.2s ease;
}

.footer__links a:hover,
.footer__meta a:hover,
.footer__links a:focus-visible,
.footer__meta a:focus-visible {
  color: var(--text);
}

@media (max-width: 940px) {
  .hero,
  .showcase,
  .experience,
  .story__grid,
  .models-grid,
  .feature-stack,
  .model-detail-hero,
  .model-detail-content,
  .model-detail-specs {
    grid-template-columns: 1fr;
  }

  .main-nav {
    display: none;
  }

  .hero {
    padding-top: 36px;
  }

  .hero__visual {
    min-height: 420px;
  }

  .footer {
    flex-direction: column;
  }

  .landing-screen__content {
    padding: 36px 22px;
  }
}

@media (max-width: 640px) {
  body {
    overflow-x: hidden;
  }

  .page-shell {
    width: min(100% - 18px, 1200px);
    margin: 12px auto 24px;
    padding: 12px 10px 0;
  }

  .topbar {
    padding: 12px 8px 14px;
    gap: 12px;
  }

  .brand {
    letter-spacing: 0.12em;
  }

  .brand-name {
    font-size: 0.7rem;
  }

  .button {
    width: 100%;
    padding: 0.8rem 1rem;
  }

  .hero__actions {
    flex-direction: column;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .hero h1,
  .story__header h2,
  .showcase__content h2,
  .experience__text h2,
  .collection-header h2 {
    font-size: clamp(2.1rem, 10vw, 3rem);
  }

  .showcase,
  .experience,
  .story,
  .hero,
  .collection-section {
    padding-left: 10px;
    padding-right: 10px;
  }

  .feature-card,
  .showcase__panel,
  .model-card,
  .experience__quote,
  .metric-panel {
    border-radius: 18px;
  }

  .panel-visual img,
  .hero__visual {
    min-height: 300px;
    height: auto;
  }

  .landing-screen__content {
    padding: 32px 18px;
  }

  .landing-screen__text {
    font-size: 0.95rem;
  }

  .metric-row {
    grid-template-columns: 1fr;
    gap: 8px;
  }
}
